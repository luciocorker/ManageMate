# Socket.IO Server Configuration
# Update this URL to point to your Socket.IO server
# For local development:
EXPO_PUBLIC_SOCKET_URL=http://localhost:3000

# For production, replace with your deployed server URL:
# EXPO_PUBLIC_SOCKET_URL=https://your-socket-server.herokuapp.com
# EXPO_PUBLIC_SOCKET_URL=https://your-socket-server.railway.app
# EXPO_PUBLIC_SOCKET_URL=https://your-socket-server.com

# Supabase Configuration (if not already set)
# EXPO_PUBLIC_SUPABASE_URL=your_supabase_url
# EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
